{
  "name": "scrylet",
  "version": "2.0.0-dev.7",
  "private": true,
  "description": "桌面连接，手机解题",
  "license": "Apache-2.0",
  "author": "Scrylet",
  "main": "desktop/main.cjs",
  "scryletMigrationProtocol": 1,
  "scryletRuntimeDefault": "node",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "npm run test:phone",
    "test:formats": "node --test tests/legacy-formats.test.cjs tests/provider-formats.test.cjs",
    "test:contracts": "node --test tests/contracts.test.cjs && tsc --noEmit -p contracts/tsconfig.json",
    "test:service": "node scripts/test-node-service.cjs",
    "test:phone": "npm run typecheck:phone && npm run build:phone && playwright test --config playwright.phone.config.cjs",
    "test:phone:asar": "npm run typecheck:phone && npm run build:phone && node scripts/test-phone-asar.cjs",
    "test:startup": "node scripts/measure-node-startup.cjs",
    "typecheck:phone": "tsc --noEmit -p phone/tsconfig.json",
    "build:phone": "vite build --config phone/vite.config.mts",
    "test:compat": "node scripts/probe-node-runtime.cjs",
    "check": "node scripts/check.cjs",
    "test:desktop": "node scripts/smoke-desktop.cjs",
    "test:desktop-ui": "node scripts/test-desktop-ui.cjs",
    "test:desktop-input": "node scripts/smoke-desktop-input.cjs",
    "build:native": "node scripts/build-native.cjs",
    "build:mac-input": "node scripts/build-mac-input.cjs",
    "test:native": "node scripts/test-native-input.cjs",
    "test:desktop-lifecycle": "node scripts/test-desktop-lifecycle.cjs",
    "test:mac-package": "node scripts/smoke-mac-package.cjs",
    "test:migration": "node scripts/test-migration.cjs",
    "test:default-migration": "node scripts/smoke-default-migration.cjs",
    "prepare:upgrade:win": "node scripts/prepare-upgrade-installers.cjs",
    "test:upgrade:win": "node scripts/smoke-windows-upgrade.cjs",
    "export:legacy": "node scripts/export-legacy.cjs",
    "test:silent": "node scripts/smoke-silent.cjs",
    "test:maintenance": "node scripts/smoke-maintenance.cjs",
    "test:network": "node scripts/smoke-network.cjs",
    "dist:win": "node scripts/dist-node-win.cjs",
    "dist:mac": "node scripts/dist-mac.cjs",
    "dist:mac:arm64": "node scripts/dist-mac.cjs --arch arm64",
    "dist:mac:x64": "node scripts/dist-mac.cjs --arch x64",
    "icons": "node scripts/generate-icons.cjs",
    "icons:mac": "node scripts/generate-icons.cjs --mac",
    "start:node": "node scripts/start-node.cjs",
    "test:release": "node scripts/release-gates.cjs",
    "test:candidate:win": "node scripts/test-node-candidate.cjs",
    "measure:package": "node scripts/measure-node-package.cjs",
    "collect:m5": "node scripts/collect-node-evidence.cjs",
    "dist:win:candidate": "node scripts/dist-node-win.cjs --profile node-candidate",
    "dist:mac:zip:arm64": "node scripts/dist-mac.cjs --arch arm64 --archive-only",
    "dist:mac:zip:x64": "node scripts/dist-mac.cjs --arch x64 --archive-only"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.110",
    "@ai-sdk/openai-compatible": "3.0.86",
    "ai": "7.0.164",
    "cropperjs": "1.6.2",
    "express": "5.3.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.168",
    "@playwright/test": "1.64.1",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.8.0",
    "electron-builder": "26.18.0",
    "html2canvas": "1.4.1",
    "katex": "0.16.47",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
