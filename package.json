{
  "name": "scrylet",
  "version": "2.0.0-dev.6",
  "private": true,
  "description": "桌面连接，手机解题",
  "license": "Apache-2.0",
  "author": "Scrylet",
  "main": "desktop/main.cjs",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "check": "node scripts/check.cjs",
    "test:desktop": "node scripts/smoke-desktop.cjs",
    "test:desktop-input": "node scripts/smoke-desktop-input.cjs",
    "test:silent": "node scripts/smoke-silent.cjs",
    "test:maintenance": "node scripts/smoke-maintenance.cjs",
    "test:network": "node scripts/smoke-network.cjs",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "dist:win": "npm run prepare:runtime && electron-builder --config electron-builder.cjs --win nsis --x64 --publish never",
    "icons": "node scripts/generate-icons.cjs"
  },
  "dependencies": {
    "cropperjs": "1.6.2",
    "express": "5.3.0",
    "http-proxy": "1.18.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.8.0",
    "electron-builder": "26.18.0"
  },
  "engines": {
    "node": ">=22"
  }
}
